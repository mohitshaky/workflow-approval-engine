# Environment Configuration
# .env.example
# Copy this file to .env and update with your values

# Database Configuration
DB_USERNAME=workflow_user
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=b2b_workflow

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO Configuration
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_secure_secret
MINIO_BUCKET=b2b-documents

# Keycloak Configuration
KEYCLOAK_ISSUER_URI=http://localhost:8080/auth/realms/b2b-platform
KEYCLOAK_JWK_SET_URI=http://localhost:8080/auth/realms/b2b-platform/protocol/openid-connect/certs

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_FROM_EMAIL=noreply@yourcompany.com

# SMS Configuration (Optional)
SMS_ENABLED=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token

# WhatsApp Configuration (Optional)
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=your_whatsapp_api_url
WHATSAPP_TOKEN=your_whatsapp_token

# Integration Settings
TALLY_INTEGRATION_ENABLED=false
TALLY_SERVER_URL=http://localhost:9000
TALLY_COMPANY_NAME=your_company

GST_VERIFICATION_ENABLED=true
GST_API_URL=https://api.gst.gov.in
GST_API_KEY=your_gst_api_key

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
